{
  // Generated by `wxt prepare`, and the source of the `chrome` API types.
  // Regenerate it after changing wxt.config.ts.
  "extends": "./.wxt/tsconfig.json",

  "compilerOptions": {
    // Only the scratch runner needs these. Browser entry points must not use
    // them; nothing enforces that yet beyond review.
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },

  "include": ["src", "tests", "wxt.config.ts", ".wxt/wxt.d.ts"]
}
